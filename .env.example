PENGINE_PERSONA_ROOT=./personas
PENGINE_DATA_DIR=./data
PENGINE_HOST=127.0.0.1
PENGINE_PORT=8000
PENGINE_RELAY_BASE_URL=
PENGINE_RELAY_API_KEY=
PENGINE_GENERATION_MODEL_ID=claude-opus-5
PENGINE_REVIEW_MODEL_ID=deepseek-v4-flash
