PENGINE_PERSONA_ROOT=./personas
PENGINE_DATA_DIR=./data
PENGINE_HOST=127.0.0.1
PENGINE_PORT=8000
PENGINE_WORKER_CONCURRENCY=5
PENGINE_RELAY_BASE_URL=https://openrouter.ai/api/v1
PENGINE_RELAY_API_KEY=
PENGINE_GENERATION_MODEL_ID=deepseek/deepseek-v4-flash
PENGINE_REVIEW_MODEL_ID=deepseek/deepseek-v4-flash
# Prefer specific OpenRouter upstreams (comma-separated provider slugs) via
# provider.order, fallbacks enabled: large cold-prefill calls go to vetted
# fast providers first, and tool-compatibility flaps degrade to default
# routing instead of failing (Issue #285). Empty = default load balancing.
# PENGINE_OPENROUTER_PROVIDER=novita,alibaba
# Per-route positive-integer caps. Keep these within the selected OpenRouter
# provider route's verified output limit:
PENGINE_GENERATION_MAX_OUTPUT_TOKENS=128000
PENGINE_REVIEW_MAX_OUTPUT_TOKENS=128000
# Verified context windows of each real route, in tokens. Preflight blocks any request
# whose estimated input plus reserved output exceeds these limits and pauses the run
# with zero outbound calls. Leaving them unset fails closed: no generation or review
# request is ever dispatched without a trustworthy verified limit.
PENGINE_GENERATION_CONTEXT_LIMIT_TOKENS=1048576
PENGINE_REVIEW_CONTEXT_LIMIT_TOKENS=1048576
PENGINE_STAGE_MODEL_CALL_LIMIT=48
PENGINE_STAGE_REVIEW_CALL_LIMIT=32
PENGINE_SCRIPT_STAGE_MODEL_CALL_TOTAL_LIMIT=192
PENGINE_SCRIPT_STAGE_REVIEW_CALL_TOTAL_LIMIT=128

# Streaming stall watchdog (Issue #266). Aborts a streaming generation call whose
# stream hangs or crawls below the floors and recovers it through the bounded
# relay-interruption path. Stall = no chunk for stream_stall_seconds (first chunk
# and inter-chunk share the value); crawl = output rate under
# stream_crawl_min_chars_per_second across a stream_crawl_window_seconds sliding
# window. Non-streaming review calls are exempt. Defaults keep >=4x margin against
# the slowest observed healthy relay window.
# PENGINE_STREAM_WATCHDOG_ENABLED=true
# PENGINE_STREAM_STALL_SECONDS=120
# PENGINE_STREAM_CRAWL_WINDOW_SECONDS=90
# PENGINE_STREAM_CRAWL_MIN_CHARS_PER_SECOND=2
# Codex-style transparent resend for generation streams: retry with jittered
# exponential backoff when a stream dies before any visible output (stall or
# silent empty EOF); never once partial output reached the consumer. These
# retries do not consume the bounded stage-attempt budget (Issue #285).
# PENGINE_STREAM_MAX_RETRIES=2
# Continuation prompting: when a stream dies after partial output was
# delivered (truncation, connection reset), replay the partial output as an
# assistant turn and ask the model to continue verbatim from the break point
# instead of discarding it (providers offer no resume token; Issue #285).
# Shares the stream_max_retries budget; disabling escalates mid-output deaths.
# PENGINE_STREAM_CONTINUATION=true
# Always-warm prefix (Claude Code pattern): before the heavy season-map call,
# send a minimal-output request with the identical message prefix to seed the
# provider-side cache; only cache-affine upstreams benefit (on the DeepSeek
# flash slug that is e.g. Alibaba/SiliconFlow — pair PENGINE_OPENROUTER_PROVIDER
# accordingly), keeping the heavy prefill seconds-short and far below the
# aggregator's ~300s processing ceiling (Issue #285).
# PENGINE_PROMPT_CACHE_WARMUP=true

# Agent observability via a self-hosted Langfuse instance (optional).
# Leave PENGINE_LANGFUSE_ENABLED unset (or false) to run with tracing off.
# To enable: `docker compose -f docker-compose.langfuse.yml up -d`, then
# copy the auto-provisioned keys from that compose file here and set ENABLED=true.
PENGINE_LANGFUSE_ENABLED=false
PENGINE_LANGFUSE_HOST=http://127.0.0.1:3001
PENGINE_LANGFUSE_PUBLIC_KEY=
PENGINE_LANGFUSE_SECRET_KEY=
