PENGINE_PERSONA_ROOT=./personas
PENGINE_DATA_DIR=./data
PENGINE_HOST=127.0.0.1
PENGINE_PORT=8000
PENGINE_RELAY_BASE_URL=
PENGINE_RELAY_API_KEY=
PENGINE_GENERATION_MODEL_ID=claude-opus-5
PENGINE_REVIEW_MODEL_ID=claude-opus-5
# Per-route positive-integer caps. Opus 5 and Sonnet 5 support at most 128,000 output tokens:
PENGINE_GENERATION_MAX_OUTPUT_TOKENS=128000
# PENGINE_REVIEW_MAX_OUTPUT_TOKENS=...
# Verified context windows of each real route, in tokens. Preflight blocks any request
# whose estimated input plus reserved output exceeds these limits and pauses the run
# with zero outbound calls. Leaving them unset fails closed: no generation or review
# request is ever dispatched without a trustworthy verified limit.
PENGINE_GENERATION_CONTEXT_LIMIT_TOKENS=200000
PENGINE_REVIEW_CONTEXT_LIMIT_TOKENS=64000
PENGINE_STAGE_MODEL_CALL_LIMIT=48
PENGINE_STAGE_REVIEW_CALL_LIMIT=32
PENGINE_SCRIPT_STAGE_MODEL_CALL_TOTAL_LIMIT=192
PENGINE_SCRIPT_STAGE_REVIEW_CALL_TOTAL_LIMIT=128

# Agent observability via a self-hosted Langfuse instance (optional).
# Leave PENGINE_LANGFUSE_ENABLED unset (or false) to run with tracing off.
# To enable: `docker compose -f docker-compose.langfuse.yml up -d`, then
# copy the auto-provisioned keys from that compose file here and set ENABLED=true.
PENGINE_LANGFUSE_ENABLED=false
PENGINE_LANGFUSE_HOST=http://127.0.0.1:3001
PENGINE_LANGFUSE_PUBLIC_KEY=
PENGINE_LANGFUSE_SECRET_KEY=
